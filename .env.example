# Copy this file to .env for local Next.js development.
# Never commit .env with real values.
# Server-only preview vars live in .dev.vars.example instead.
# After editing secrets, review with: pnpm cf:secret:sync --dry-run

# --- Required build-time: Firebase public web config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, defaults to us-central1
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=
# --- Required build-time: Turnstile widget ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# --- Required build-time: TMDB (either one) ---
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# --- Secrets (synced to Cloudflare via pnpm cf:secret:sync) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
TURNSTILE_SECRET_KEY=
TRAKT_CLIENT_ID=
# Optional, enables IMDb/Rotten Tomatoes/Metacritic ratings on detail pages
OMDB_API_KEY=
# Required for Premium billing (Polar checkout + customer portal)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID_MONTHLY=
POLAR_PRODUCT_ID_YEARLY=

# --- Optional runtime (non-secret URL override) ---
TRAKT_BACKEND_URL=
